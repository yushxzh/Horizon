{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "ai-infra"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langgraph",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "type": "repo_releases",
        "owner": "oven-sh",
        "repo": "bun",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "type": "repo_releases",
        "owner": "denoland",
        "repo": "deno",
        "enabled": true,
        "category": "developer-tools"
      },
      {
        "type": "repo_releases",
        "owner": "kubernetes",
        "repo": "kubernetes",
        "enabled": true,
        "category": "cloud-native"
      },
      {
        "type": "repo_releases",
        "owner": "docker",
        "repo": "compose",
        "enabled": true,
        "category": "cloud-native"
      },
      {
        "type": "repo_releases",
        "owner": "aquasecurity",
        "repo": "trivy",
        "enabled": true,
        "category": "security"
      },
      {
        "type": "repo_releases",
        "owner": "anchore",
        "repo": "grype",
        "enabled": true,
        "category": "security"
      },
      {
        "type": "repo_releases",
        "owner": "cli",
        "repo": "cli",
        "enabled": true,
        "category": "open-source"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 50,
      "min_score": 100,
      "category": "software-engineering"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-research"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Martin Fowler",
        "url": "https://martinfowler.com/feed.atom",
        "enabled": true,
        "category": "software-engineering"
      },
      {
        "name": "GitHub Engineering",
        "url": "https://github.blog/engineering/feed/",
        "enabled": true,
        "category": "software-engineering"
      },
      {
        "name": "Cloudflare Blog",
        "url": "https://blog.cloudflare.com/rss/",
        "enabled": true,
        "category": "cloud-native"
      },
      {
        "name": "Kubernetes Blog",
        "url": "https://kubernetes.io/feed.xml",
        "enabled": true,
        "category": "cloud-native"
      },
      {
        "name": "Schneier on Security",
        "url": "https://www.schneier.com/feed/atom/",
        "enabled": true,
        "category": "security"
      },
      {
        "name": "GitHub Security",
        "url": "https://github.blog/security/feed/",
        "enabled": true,
        "category": "security"
      },
      {
        "name": "Snyk Blog",
        "url": "https://snyk.io/blog/feed/",
        "enabled": true,
        "category": "security"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "category": "ai-research"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 40,
          "category": "ai-tools"
        },
        {
          "subreddit": "programming",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 100,
          "category": "software-engineering"
        },
        {
          "subreddit": "netsec",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 40,
          "category": "security"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": true,
      "mode": "apify",
      "users": [
        "OpenAI",
        "AnthropicAI",
        "GoogleDeepMind",
        "karpathy",
        "simonw",
        "troyhunt",
        "mitchellh",
        "github"
      ],
      "fetch_limit": 4,
      "category": "developer-pulse",
      "fetch_reply_text": false,
      "apify_token_env": "APIFY_TOKEN",
      "actor_id": "automation-lab~twitter-scraper"
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "filtering": {
    "ai_score_threshold": 7.5,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "ai": {
        "name": "AI / LLM",
        "limit": 7,
        "categories": [
          "ai-news",
          "ai-research",
          "ai-tools",
          "ai-infra"
        ]
      },
      "engineering": {
        "name": "软件工程",
        "limit": 7,
        "categories": [
          "software-engineering",
          "developer-tools",
          "cloud-native"
        ]
      },
      "open_source": {
        "name": "开源工具",
        "limit": 4,
        "categories": [
          "open-source"
        ]
      },
      "security": {
        "name": "安全",
        "limit": 4,
        "categories": [
          "security"
        ]
      },
      "developer_pulse": {
        "name": "开发者动态",
        "limit": 4,
        "categories": [
          "developer-pulse"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 2
  }
}
